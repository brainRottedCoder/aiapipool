# Web app env — copy to repo root `.env` (loaded via next.config) or `apps/web/.env.local`
DATABASE_URL=postgresql://fluxai:local_dev_password@localhost:5432/fluxai

AUTH_SECRET=replace_with_32_byte_min_auth_secret_for_dev_only
AUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=replace_with_32_byte_min_auth_secret_for_dev_only
NEXTAUTH_URL=http://localhost:3001

NEXT_PUBLIC_API_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
