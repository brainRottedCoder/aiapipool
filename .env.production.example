# =============================================================
# FluxAI API — Production Environment Variables
# =============================================================
# Copy this file to .env and fill in real values before deploying.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string (use a strong password in prod)
DATABASE_URL=postgresql://fluxai:CHANGE_ME_STRONG_PASSWORD@postgres:5432/fluxai

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Security ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
MASTER_ENCRYPTION_KEY=
# Generate with: openssl rand -base64 48
API_KEY_PEPPER=
# Generate with: openssl rand -base64 48
ADMIN_API_KEY=

# ── Stripe (optional until payments are enabled) ──────────────
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# ── NextAuth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET=
# Public dashboard URL (CORS + Stripe redirects)
NEXTAUTH_URL=https://app.yourdomain.com
WEB_APP_URL=https://app.yourdomain.com

# ── OAuth Providers ───────────────────────────────────────────
# Create apps at:
#   GitHub: https://github.com/settings/developers
#   Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Azure Key Vault (optional) ───────────────────────────────
AZURE_KEY_VAULT_URL=

# ── Rate Limits ──────────────────────────────────────────────
DEFAULT_RPM=60
DEFAULT_TOKENS_PER_DAY=100000
MAX_CONCURRENT_REQUESTS=10

# ── Seed (first deploy only) ─────────────────────────────────
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
